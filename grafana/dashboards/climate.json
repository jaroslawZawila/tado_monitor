{
  "uid": "tado-climate",
  "title": "Home climate",
  "tags": [
    "tado",
    "matter"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "room",
        "label": "Room",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "tado-pg"
        },
        "query": "SELECT DISTINCT name FROM devices ORDER BY 1",
        "definition": "SELECT DISTINCT name FROM devices ORDER BY 1",
        "refresh": 1,
        "sort": 0,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Temperature now",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tado-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tado-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, metric, value FROM (\n  SELECT DISTINCT ON (name) ts AS time, name AS metric, value\n  FROM named_readings\n  WHERE name IN ($room) AND metric = 'temperature' AND ts > now() - interval '30 minutes'\n  ORDER BY name, ts DESC\n) latest\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
