# Copy to `.env` (next to docker-compose.yml) and uncomment what applies.
# Every value has a working default.

# Start Grafana too. Leave unset on a 1 GB Pi 3; set on a laptop or Pi 4.
#COMPOSE_PROFILES=grafana
#GRAFANA_ADMIN_PASSWORD=admin

# Interface the Matter server uses for mDNS. Empty = auto-detect.
# Raspberry Pi: eth0 (recommended) or wlan0. Laptop here: wlo1.
#MATTER_INTERFACE=eth0

# Cap the Matter server's Node.js heap. Only needed on a 1 GB Pi 3.
#MATTER_NODE_OPTIONS=--max-old-space-size=256

# Collector settings (src/tado_monitor/config.py), prefix TADO_.
#TADO_MATTER_WS_URL=ws://127.0.0.1:5580/ws
#TADO_DATABASE_URL=postgresql://tado:tado@127.0.0.1:5433/tado
#TADO_SNAPSHOT_INTERVAL_S=300
